{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "npm test && npm run test:parity && node scripts/build_web.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/JOUER.html",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"JOUER.html\"" }
      ]
    }
  ]
}
